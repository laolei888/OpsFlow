# Copy this file to deploy/.env.demo and replace every CHANGE_ME value.
OPSFLOW_IMAGE_TAG=main
OPSFLOW_HTTP_PORT=8081

MYSQL_DATABASE=opsflow
MYSQL_USER=opsflow
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
OPSFLOW_CORS_ALLOWED_ORIGINS=https://opsflow.example.com

# Optional first administrator. Remove after the account has been created.
OPSFLOW_BOOTSTRAP_USERNAME=
OPSFLOW_BOOTSTRAP_PASSWORD=
OPSFLOW_BOOTSTRAP_DISPLAY_NAME=OpsFlow 管理员
OPSFLOW_BOOTSTRAP_ROLE=ADMIN
OPSFLOW_BOOTSTRAP_TENANT_ID=1
