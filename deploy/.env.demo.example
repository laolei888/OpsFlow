# Copy this file to deploy/.env.demo and replace every CHANGE_ME value.
OPSFLOW_IMAGE_TAG=main
OPSFLOW_HTTP_PORT=8081

MYSQL_DATABASE=opsflow
MYSQL_USER=opsflow
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
RABBITMQ_USERNAME=opsflow
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
OPSFLOW_CORS_ALLOWED_ORIGINS=https://opsflow.example.com

# Attachment storage: keep LOCAL for a single-host demo, or configure S3-compatible storage.
OPSFLOW_STORAGE_TYPE=LOCAL
OPSFLOW_STORAGE_PRESIGNED_TTL=PT5M
OPSFLOW_STORAGE_S3_ENABLED=false
OPSFLOW_STORAGE_S3_ENDPOINT=
OPSFLOW_STORAGE_S3_PUBLIC_ENDPOINT=
OPSFLOW_STORAGE_S3_REGION=us-east-1
OPSFLOW_STORAGE_S3_ACCESS_KEY=
OPSFLOW_STORAGE_S3_SECRET_KEY=
OPSFLOW_STORAGE_S3_BUCKET=opsflow-attachments
OPSFLOW_STORAGE_S3_PATH_STYLE=true
OPSFLOW_STORAGE_S3_AUTO_CREATE_BUCKET=false
OPSFLOW_STORAGE_S3_AUTO_CONFIGURE_CORS=false
OPSFLOW_STORAGE_S3_CORS_ALLOWED_ORIGINS=https://opsflow.example.com
OPSFLOW_STORAGE_MULTIPART_ENABLED=true
OPSFLOW_STORAGE_MULTIPART_PART_SIZE=8388608
OPSFLOW_STORAGE_MULTIPART_MAX_FILE_SIZE=1073741824
OPSFLOW_STORAGE_MULTIPART_PRESIGNED_TTL=PT15M
OPSFLOW_STORAGE_MULTIPART_SESSION_TTL=PT24H
OPSFLOW_STORAGE_MULTIPART_RETENTION_DAYS=7

# Optional first administrator. Remove after the account has been created.
OPSFLOW_BOOTSTRAP_USERNAME=
OPSFLOW_BOOTSTRAP_PASSWORD=
OPSFLOW_BOOTSTRAP_DISPLAY_NAME=OpsFlow 管理员
OPSFLOW_BOOTSTRAP_ROLE=ADMIN
OPSFLOW_BOOTSTRAP_TENANT_ID=1
