# Local Docker Compose example. Copy to .env and replace every CHANGE_ME value.
MYSQL_DATABASE=opsflow
MYSQL_USER=opsflow
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
RABBITMQ_USERNAME=opsflow
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD

# Optional bootstrap account. Leave both empty to disable automatic account creation.
OPSFLOW_BOOTSTRAP_USERNAME=
OPSFLOW_BOOTSTRAP_PASSWORD=
OPSFLOW_BOOTSTRAP_DISPLAY_NAME=OpsFlow 客服
OPSFLOW_BOOTSTRAP_ROLE=AGENT
OPSFLOW_BOOTSTRAP_TENANT_ID=1

# Browser/API security settings.
OPSFLOW_REGISTRATION_ENABLED=true
OPSFLOW_CORS_ALLOWED_ORIGINS=
OPSFLOW_LOGIN_MAX_FAILURES=5
OPSFLOW_LOGIN_LOCK_DURATION=PT15M
OPSFLOW_OUTBOUND_ALLOW_PRIVATE_NETWORKS=false
OPSFLOW_OUTBOUND_ALLOWED_HOSTS=

# Optional multichannel notification email adapter. Personal Webhooks work without SMTP.
OPSFLOW_NOTIFICATION_EMAIL_ENABLED=false
OPSFLOW_NOTIFICATION_EMAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Attachment quarantine scanning. The built-in policy engine is always enabled.
# Start `docker compose --profile antivirus up -d` to enable the optional ClamAV adapter.
OPSFLOW_ATTACHMENT_CLAMAV_ENABLED=false
OPSFLOW_ATTACHMENT_CLAMAV_HOST=clamav
OPSFLOW_ATTACHMENT_CLAMAV_PORT=3310
OPSFLOW_ATTACHMENT_CLAMAV_TIMEOUT_MS=5000
OPSFLOW_ATTACHMENT_ARCHIVE_MAX_ENTRIES=2000
OPSFLOW_ATTACHMENT_ARCHIVE_MAX_EXPANDED_BYTES=104857600
OPSFLOW_ATTACHMENT_ARCHIVE_MAX_RATIO=100

# Attachment backend. Keep LOCAL, or set type=S3 and enabled=true before starting
# `docker compose --profile object-storage up -d --build`.
OPSFLOW_STORAGE_TYPE=LOCAL
OPSFLOW_STORAGE_PRESIGNED_TTL=PT5M
OPSFLOW_STORAGE_S3_ENABLED=false
OPSFLOW_STORAGE_S3_ENDPOINT=http://object-storage:9000
OPSFLOW_STORAGE_S3_PUBLIC_ENDPOINT=http://localhost:9000
OPSFLOW_STORAGE_S3_REGION=us-east-1
OPSFLOW_STORAGE_S3_ACCESS_KEY=opsflow
OPSFLOW_STORAGE_S3_SECRET_KEY=CHANGE_ME_OBJECT_STORAGE_PASSWORD
OPSFLOW_STORAGE_S3_BUCKET=opsflow-attachments
OPSFLOW_STORAGE_S3_PATH_STYLE=true
OPSFLOW_STORAGE_S3_AUTO_CREATE_BUCKET=true
OPSFLOW_STORAGE_S3_AUTO_CONFIGURE_CORS=true
OPSFLOW_STORAGE_S3_CORS_ALLOWED_ORIGINS=http://localhost:8081
OPSFLOW_STORAGE_MULTIPART_ENABLED=true
OPSFLOW_STORAGE_MULTIPART_PART_SIZE=8388608
OPSFLOW_STORAGE_MULTIPART_MAX_FILE_SIZE=1073741824
OPSFLOW_STORAGE_MULTIPART_PRESIGNED_TTL=PT15M
OPSFLOW_STORAGE_MULTIPART_SESSION_TTL=PT24H
OPSFLOW_STORAGE_MULTIPART_RETENTION_DAYS=7

# Capacity snapshots and threshold-based growth forecasts.
OPSFLOW_APP_VERSION=local
OPSFLOW_CAPACITY_CAPTURE_INTERVAL_MS=3600000
OPSFLOW_CAPACITY_RETENTION_DAYS=180
OPSFLOW_CAPACITY_ACTIVE_TICKETS=5000
OPSFLOW_CAPACITY_OVERDUE_TICKETS=500
OPSFLOW_CAPACITY_ACTIVE_INCIDENTS=20
OPSFLOW_CAPACITY_FIRING_ALERTS=100
OPSFLOW_CAPACITY_ASYNC_BACKLOG=1000
OPSFLOW_CAPACITY_ATTACHMENT_BACKLOG=500
OPSFLOW_CAPACITY_ATTACHMENT_BYTES=5368709120
OPSFLOW_CAPACITY_DATABASE_BYTES=10737418240

# Observability dashboard. Never keep these defaults on a shared environment.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
