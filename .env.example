# Local Docker Compose example. Copy to .env and replace every CHANGE_ME value.
MYSQL_DATABASE=opsflow
MYSQL_USER=opsflow
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES

# Optional bootstrap account. Leave both empty to disable automatic account creation.
OPSFLOW_BOOTSTRAP_USERNAME=
OPSFLOW_BOOTSTRAP_PASSWORD=
OPSFLOW_BOOTSTRAP_DISPLAY_NAME=OpsFlow 客服
OPSFLOW_BOOTSTRAP_ROLE=AGENT
OPSFLOW_BOOTSTRAP_TENANT_ID=1

# Browser/API security settings.
OPSFLOW_REGISTRATION_ENABLED=true
OPSFLOW_CORS_ALLOWED_ORIGINS=
OPSFLOW_LOGIN_MAX_FAILURES=5
OPSFLOW_LOGIN_LOCK_DURATION=PT15M
OPSFLOW_OUTBOUND_ALLOW_PRIVATE_NETWORKS=false
OPSFLOW_OUTBOUND_ALLOWED_HOSTS=

# Observability dashboard. Never keep these defaults on a shared environment.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
